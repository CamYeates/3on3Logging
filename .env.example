# Supabase project credentials.
# Find these in your Supabase project dashboard under Project Settings > API.
# These are PUBLIC client keys (anon key is safe to ship in a client app when RLS is enabled).
#
# Copy this file to apps/mobile/.env and fill in real values:
#   cp .env.example apps/mobile/.env

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
